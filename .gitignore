# coverage --cov-report=json artefact, regenerated by the ratchet gate
coverage.json

# AUDIT04: the root .coverage binary was TRACKED while the identical artefact in
# imp-causal-paper (line 43 above) was ignored -- one class of file, two policies.
# It is a SQLite database rewritten by every --cov run, nothing reads it, and its
# readable sibling coverage.json is already ignored. Untracked here.
.coverage

# Partial MUnit runs (--section / --gate) write their own scoped Status.txt so
# they cannot overwrite the tracked whole-suite rollup. Those scoped files are
# developer scratch and carry no claim; only results/tests/runall/ is evidence.
results/tests/section-*/
