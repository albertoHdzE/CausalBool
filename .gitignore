# MANIFEST.sha256 + scripts/verify_manifest.py
imp-causal-paper/results/*
!imp-causal-paper/results/index_method_comparison/
imp-causal-paper/plots/
imp-causal-paper/data/raw/
imp-causal-paper/data/processed/
