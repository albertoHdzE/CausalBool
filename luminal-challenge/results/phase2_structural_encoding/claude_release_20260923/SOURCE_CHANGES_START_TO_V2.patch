+def _primary_markdown(primary: dict) -> List[str]:
+    """The confirmatory H2 section of COMPARISON.md, rendered from primary_h2."""
+    analysis = primary.get("analysis") or {}
+    interval = (analysis.get("interval") or {})
+    bounds = (interval.get("intervals") or {}).get("0.025-0.975")
+    point = interval.get("point_estimate")
+    estimate = ("n/a" if point is None or bounds is None
+                else f"{point:.4g} [{bounds[0]:.4g}, {bounds[1]:.4g}]")
+    if bounds is None:
+        reading = "not estimable"
+    elif bounds[0] > 0:
+        reading = "interval above zero: the candidate has lower J"
+    elif bounds[1] < 0:
+        reading = "interval below zero: the candidate has higher J"
+    else:
+        reading = "interval crosses zero: inconclusive, not equivalence"
+    return [
+        "## Primary H2 (confirmatory)", "",
+        f"Corpus `{primary.get('corpus')}`, budget {primary.get('budget_seconds')} s, "
+        f"`{analysis.get('candidate_arm')}` versus `{primary.get('control')}`. "
+        f"Endpoint: {analysis.get('endpoint')}.", "",
+        "| Programs (paired/expected) | Families | Estimate [95% interval] | W/T/L | Reading |",
+        "|---:|---|---|---:|---|",
+        f"| {analysis.get('programs')}/{analysis.get('expected_programs', 'n/a')} | "
+        f"{interval.get('families')} | {estimate} | "
+        f"{analysis.get('wins')}/{analysis.get('ties')}/{analysis.get('losses')} | {reading} |",
