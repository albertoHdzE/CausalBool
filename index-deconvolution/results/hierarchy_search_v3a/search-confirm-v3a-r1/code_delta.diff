diff --color -ruN --exclude=__pycache__ index-deconvolution/hierarchy/search_v3a.py /Users/alberto/Documents/projects/CausalBool/index-deconvolution/hierarchy/search_v3a.py
--- index-deconvolution/hierarchy/search_v3a.py	1969-12-31 18:00:00
+++ /Users/alberto/Documents/projects/CausalBool/index-deconvolution/hierarchy/search_v3a.py	2026-10-04 07:15:33
@@ -0,0 +1,69 @@
+"""HID-search-v3a policy/config adapter (protocols/hierarchy_search_v3a/SEARCH.md).
+
+Two full-method arms over the one orchestrator ``search_v2.run_arm``:
+
