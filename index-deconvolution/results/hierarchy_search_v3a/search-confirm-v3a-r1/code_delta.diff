+def test_mixed_signs_inconclusive_and_precedence_invalid_then_incomplete():
+    d = _design()
+    out = R3.decision(_val(_index(d, lambda sp, bl, rep, rg: (1000, 1000 + (5 if rep % 2 else -5)))), d)
+    assert out["verdict"] == "INCONCLUSIVE"
