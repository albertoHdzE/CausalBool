diff --git a/src/description_lengths.py b/src/description_lengths.py
index ea90160f..a8a33d28 100644
--- a/src/description_lengths.py
+++ b/src/description_lengths.py
@@ -197,3 +197,57 @@ def bdm_2d(array, below_floor: str = "none") -> float | None:
     if below_floor == "raise" and (a.shape[0] < 4 or a.shape[1] < 4):
         raise ValueError(f"BDM floor violated: shape {a.shape}")
     return float(BDM(ndim=2).bdm(a))
+
+
+# --- 1-D CTM / BDM over binary strings ----------------------------------------
+#
+# Added for index-deconvolution notebook 15 (the shifted-zero probe of BDM).
+# Same pin, same rule as bdm_2d: the partition is chosen by the caller, never
+# silently. pybdm's default 1-D partition DROPS any remainder shorter than the
+# block, so a 20-bit string under block 12 is scored on its first 12 bits only.
+# That is refused here unless the caller asks for it.
+
+def _bits(bits):
+    import numpy as np
+    if isinstance(bits, str):
+        bits = [int(c) for c in bits]
+    a = np.asarray(bits, dtype=int)
+    if a.ndim != 1 or a.size == 0 or not set(np.unique(a)) <= {0, 1}:
+        raise ValueError("expected a non-empty 1-D binary string")
+    return a
+
+
+def ctm_1d(bits) -> float:
+    """CTM (bits) of a binary string of length 1..12, looked up in pybdm's
+    CTM-B2-D12 table (Soler-Toscano et al. 2014, D(5) machines)."""
+    _check_pybdm()
+    from pybdm import BDM
+    a = _bits(bits)
+    if a.size > 12:
+        raise ValueError(f"CTM table covers lengths 1..12, got {a.size}")
+    return float(BDM(ndim=1, shape=(a.size,)).bdm(a))
+
+
+def bdm_1d(bits, block: int = 12, shift: int | None = None,
+           remainder: str = "raise") -> float:
+    """pybdm 1-D BDM: sum over DISTINCT blocks of CTM(block) + log2(multiplicity).
+
+    block      block length, 1..12 (the CTM table's range);
+    shift      None -> non-overlapping blocks (pybdm PartitionIgnore);
+               k    -> sliding blocks with step k (pybdm PartitionCorrelated);
+    remainder  "raise" -> refuse a length that the blocks do not tile exactly;
+               "drop"  -> pybdm's own behaviour, trailing bits ignored.
+    """
+    _check_pybdm()
+    from pybdm import BDM
+    from pybdm.partitions import PartitionCorrelated
+    a = _bits(bits)
+    if not 1 <= block <= 12:
+        raise ValueError(f"block must be 1..12, got {block}")
+    step = block if shift is None else shift
+    if remainder == "raise" and (a.size - block) % step != 0:
+        raise ValueError(f"length {a.size} not tiled by block {block} step {step}")
+    if shift is None:
+        return float(BDM(ndim=1, shape=(block,)).bdm(a))
+    return float(BDM(ndim=1, shape=(block,), partition=PartitionCorrelated,
+                     shift=shift).bdm(a))
diff --git a/tests/analysis/test_description_lengths_values.py b/tests/analysis/test_description_lengths_values.py
