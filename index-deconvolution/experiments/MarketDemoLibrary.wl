(* MarketDemoLibrary.wl

   Plotting and statistics for the market comparison notebook.  Imports the
   out-of-sample comparison data exported by exp06_market_simulation.py and
   builds the real-versus-model-generated path plot and the per-instrument
   accuracy chart.  No dependency on the rest of the codebase (plotting only).
*)

MarketComparison[path_] := Module[
  {d, real, pred, acc, base, perT, tickers, accs, bases, pathPlot, barPlot, edge},
  d = Import[path, "RawJSON"];
  real = d["real_cum"]; pred = d["pred_cum"];
  acc = d["oos_accuracy"]; base = d["base_rate"];
  edge = d["mean_oos_accuracy"] - d["mean_base_rate_test"];

  Print["representative instrument           : ", d["representative"]];
  Print["out-of-sample directional accuracy  : ", acc, "  (base rate ", base, ")"];
  Print["mean OOS accuracy across instruments : ", d["mean_oos_accuracy"],
    "  (mean base rate ", d["mean_base_rate_test"], ")"];
  Print["mean out-of-sample edge over base    : ", edge];
  Print["contradiction rate, all days         : ", d["daily_contradiction"]];
  Print["contradiction rate, disruptive days  : ", d["event_contradiction"]];

  pathPlot = ListLinePlot[{real, pred},
    PlotLegends -> {"real", "generated by deconvolution model"},
    PlotLabel -> "Real vs model-generated cumulative path (" <> d["representative"] <>
      ", out-of-sample)",
    FrameLabel -> {"test day", "cumulative return"}, Frame -> True,
    ImageSize -> 520];

  perT = d["per_ticker"];
  tickers = #["ticker"] & /@ perT;
  accs = #["oos_accuracy"] & /@ perT;
  bases = #["base_rate"] & /@ perT;
  barPlot = BarChart[Transpose[{accs, bases}],
    ChartLegends -> {"OOS accuracy", "base rate"},
    ChartLabels -> {Placed[tickers, Axis, Rotate[#, Pi/2] &], None},
    PlotLabel -> "Out-of-sample directional accuracy vs base rate, by instrument",
    ImageSize -> 640];

  <|"pathPlot" -> pathPlot, "barPlot" -> barPlot, "edge" -> edge|>];
